<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on Wanderlust</h1>
    <div class="col-6 offset-3 mb-5">
        <form action="/signup" method="POST" class="needs-validation" novalidate> 
            
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="username" type="text" class="form-control" required/>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please choose a username</div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" type="email" class="form-control" required/>
                <div class="invalid-feedback">Please enter a valid email address</div>
            </div>

            <div class="mb-3">
    <label for="password" class="form-label">Please enter your password</label>
    <div class="input-group">
        <input type="password" name="password" id="password" class="form-control" >
        <button class="btn btn-outline-secondary" type="button" id="loginPasswordToggle">
            <i class="fa-solid fa-eye"></i>
        </button>
    </div>
</div>
<script>
    document.getElementById("loginPasswordToggle").addEventListener("click", function() {
        const passwordInput = document.getElementById("password");
        const icon = this.querySelector("i");
        
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            icon.classList.replace("fa-eye", "fa-eye-slash");
        } else {
            passwordInput.type = "password";
            icon.classList.replace("fa-eye-slash", "fa-eye");
        }
    });
</script>
            <div class="mb-3">
    <label for="role" class="form-label">Join As</label>
    <select name="role" id="role" class="form-select" required>
        <option value="guest" selected>Guest (Want to book stays)</option>
        <option value="host">Host (Want to list my property)</option>
    </select>
    <div class="invalid-feedback">Please select a role.</div>
</div>

            <button class="btn btn-success px-4">SignUp</button>
        </form>
    </div>
</div>