<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <h2 class="col-6 offset-3">Forgot Password</h2>
    <div class="col-6 offset-3 mt-2">
        <form action="/forgot" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="email" class="form-label">Enter your registered Email ID</label>
                <input type="email" name="email" id="email" class="form-control" required>
            </div>
            <button class="btn btn-danger rounded-pill px-4">Send Reset Link</button>
        </form>
    </div>
</div>