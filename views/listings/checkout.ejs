<% layout("/layouts/boilerplate") %>

<div class="row mt-5 justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0 p-4 rounded-4">
            <h3 class="text-center mb-4"><i class="fa-solid fa-file-invoice-dollar text-danger"></i> Booking Invoice</h3>
            <hr/>
            <div class="mb-3">
                <h5><strong>Property:</strong> <%= listing.title %></h5>
                <p class="text-muted"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
            </div>
            <div class="row bg-light p-3 rounded-3 mb-4">
                <div class="col-6">
                    <small class="text-muted d-block">CHECK-IN</small>
                    <strong><%= startDate %></strong>
                </div>
                <div class="col-6 text-end">
                    <small class="text-muted d-block">CHECK-OUT</small>
                    <strong><%= endDate %></strong>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="fs-5">Total Amount to Pay:</span>
                <span class="fs-3 fw-bold text-danger">₹<%= totalPrice.toLocaleString("en-IN") %></span>
            </div>

            <button id="rzp-button1" class="btn btn-danger w-100 btn-lg rounded-3 py-2 fw-bold">Proceed to Secure Pay</button>
        </div>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
var options = {
    "key": "<%= key_id %>", 
    "amount": "<%= order.amount %>", 
    "currency": "INR",
    "name": "Wanderlust Inc.",
    "description": "Booking for Stay",
    "order_id": "<%= order.id %>", // Created on backend
    "handler": function (response){
        // Agar payment success hoti hai, toh hum safe route par redirect karenge
        window.location.href = "<%- successRedirectUrl %>&payment_id=" + response.razorpay_payment_id;
    },
    "prefill": {
        "name": "<%= currUser.username %>",
        "email": "<%= currUser.email || 'guest@wanderlust.com' %>"
    },
    "theme": {
        "color": "#fe424d" // Wanderlust matching red theme color
    }
};
var rzp1 = new Razorpay(options);
document.getElementById('rzp-button1').onclick = function(e){
    rzp1.open();
    e.preventDefault();
}
</script>