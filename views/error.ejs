<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-6 offset-3">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading"><i class="fa-solid fa-circle-exclamation"></i> Something Went Wrong!</h4>
            <p class="mb-0"><%= err.message %></p>
        </div>
        
        <% if (process.env.NODE_ENV !== "production" && err.stack) { %>
            <div class="mt-3">
                <p>
                    <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#errorStack" aria-expanded="false" aria-controls="errorStack">
                        View Error Stack Trace
                    </button>
                </p>
                <div class="collapse" id="errorStack">
                    <div class="card card-body bg-light text-danger font-monospace" style="font-size: 0.85rem; overflow-x: auto;">
                        <pre class="mb-0"><%= err.stack %></pre>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>